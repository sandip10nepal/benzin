# Benzin Hospitality OS — Environment Configuration Template
# Copy this file to .env and replace placeholders with your credentials.
# NEVER commit your actual .env file or real secrets to Git.

# Server Port
PORT=3000

# Environment: 'development' | 'production'
NODE_ENV=development

# Database Mode:
# - 'mongodb': Authoritative MongoDB Atlas (mandatory in production)
# - 'local': Local JSON mode for offline development (multi_tenant_db.json)
DATABASE_MODE=mongodb

# MongoDB Atlas Connection URI
MONGODB_URI=mongodb+srv://<DB_USERNAME>:<DB_PASSWORD>@<CLUSTER>.mongodb.net/benzin_saas_db?retryWrites=true&w=majority

# JWT Signing Secret (Generate with: openssl rand -base64 32)
JWT_SECRET=change-me-to-a-secure-random-secret-key-32-chars

# Token Expiries in Seconds
JWT_EXPIRY_SECONDS=86400
DEVICE_JWT_EXPIRY_SECONDS=31536000

# Square Payment Integration
SQUARE_ENVIRONMENT=sandbox
SQUARE_ACCESS_TOKEN=your_sandbox_or_production_access_token
SQUARE_LOCATION_ID=your_square_location_id
SQUARE_DEMO_MODE=true

# Google Cloud Storage Media Bucket (Leave empty in local dev for local mock storage)
# Production bucket: benzin-public-media-833090629754
GCS_MEDIA_BUCKET=

